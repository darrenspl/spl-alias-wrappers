# One style for every editor. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_size = 2

[*.md]
# Two spaces at the end of a markdown line is a line break, so keep them.
trim_trailing_whitespace = false
